{
  "name": "cortico-world-dsh",
  "version": "0.1.3",
  "type": "module",
  "description": "Cortico World: DSH 启动器 — 替你把 DeepSeek Harness 的 dsh web 拉起来、打开、或者关掉。",
  "license": "MIT",
  "author": "Uesugikumo (https://github.com/Uesugikumo)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Uesugikumo/cortico-world-dsh.git"
  },
  "homepage": "https://github.com/Uesugikumo/cortico-world-dsh#readme",
  "bugs": {
    "url": "https://github.com/Uesugikumo/cortico-world-dsh/issues"
  },
  "keywords": [
    "cortico-world",
    "cortico",
    "dsh",
    "deepseek-harness",
    "launcher"
  ],
  "engines": {
    "node": ">=22"
  },
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "cortico": {
    "kind": "world",
    "api": 6,
    "displayName": "DSH 启动器",
    "icon": "assets/icon.svg",
    "tags": [
      "external-setup",
      "apps"
    ],
    "locales": {
      "en": {
        "displayName": "DSH launcher",
        "description": "Starts, opens and stops the DeepSeek Harness web UI (dsh web) for your companion."
      }
    },
    "describe": "describe.json",
    "webUiClient": "dist/webui.js",
    "webUiStyle": "dist/webui.css"
  },
  "files": [
    "src",
    "dist",
    "assets",
    "describe.json",
    "README.md",
    "CHANGELOG.md"
  ]
}
